{
  "name": "qik-ledger-api",
  "version": "0.0.1",
  "description": "Qik Accounts & Ledger Service (NestJS + GraphQL)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:run": "nest build && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/database/data-source.js migration:revert",
    "migration:show": "nest build && typeorm -d dist/database/data-source.js migration:show",
    "test:all": "npm run test && npm run test:e2e",
    "test:cov:e2e": "vitest run --config ./vitest.config.e2e.ts --coverage"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "graphql": "^16.15.0",
    "pg": "^8.23.1",
    "redis": "^5.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
