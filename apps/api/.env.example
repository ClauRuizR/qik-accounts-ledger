# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list; empty = allow any origin outside production
CORS_ORIGINS=

# ── PostgreSQL (must match the root .env used by docker compose) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=qik_user
DATABASE_PASSWORD=change-me
DATABASE_NAME=qik_ledger
# Separate database used by integration tests (created automatically)
DATABASE_TEST_NAME=qik_ledger_test
DATABASE_LOGGING=false

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SUMMARY_CACHE_TTL_SECONDS=300

# ── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600
