{
  "name": "qik-ledger-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.25",
    "expo-crypto": "~58.0.8",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "graphql": "^17.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "format": "prettier --write \"App.tsx\" \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"App.tsx\" \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/test-utils/**",
      "!src/**/__tests__/**",
      "!src/navigation/types.ts",
      "!src/types/**"
    ]
  }
}
